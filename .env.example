# --- CONFIGURACIÓN PARA RENDER (BACKEND) ---
# Estas variables se configuran automáticamente en Render si usas el Blueprint (render.yaml)
# Pero aquí tienes una referencia:

DATABASE_URL=postgres://user:pass@host:5432/dbname
REDIS_URL=redis://user:pass@host:port
JWT_SECRET=tu_secreto_super_seguro
PORT=4000

# --- ALMACENAMIENTO CLOUDFLARE R2 / S3 (OPCIONAL PERO RECOMENDADO) ---
S3_BUCKET=tu-nombre-de-bucket
S3_ENDPOINT=https://tu-id-de-cuenta.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=tu_access_key_id
S3_SECRET_ACCESS_KEY=tu_secret_access_key

# --- CONFIGURACIÓN PARA PORTAL WEB (FRONTEND) ---
VITE_API_URL=https://rutazero-backend.onrender.com
